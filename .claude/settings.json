{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm *)",
      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm audit*)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(corepack *)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform plan*)",
      "Bash(terraform init*)",
      "Bash(terraform show*)",
      "Bash(terraform state list*)",
      "Bash(terraform state show*)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(seq *)",
      "Bash(xargs *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(touch *)",
      "Bash(mkdir *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(mv /tmp/*)",
      "Bash(rm /tmp/*)",
      "Bash(rm -rf /tmp/*)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(env*)",
      "Bash(printenv*)",
      "Bash(jq *)",
      "Bash(curl -s *)",
      "Bash(curl -i *)"
    ],
    "ask": [
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform import*)",
      "Bash(terraform state mv*)",
      "Bash(terraform state rm*)",
      "Bash(aws * delete*)",
      "Bash(aws * put*)",
      "Bash(aws * create*)",
      "Bash(aws * update*)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.*.local)",
      "Read(**/terraform.tfstate)",
      "Read(**/terraform.tfstate.backup)",
      "Read(**/*.tfvars)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(.env.*.local)",
      "Edit(**/terraform.tfstate)",
      "Edit(**/*.tfvars)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.production)",
      "Write(**/terraform.tfstate)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .git)",
      "Bash(rm -rf **/.git)",
      "Bash(terraform apply -auto-approve*)",
      "Bash(terraform destroy -auto-approve*)",
      "Bash(curl *|*sh)",
      "Bash(curl *|*bash)",
      "Bash(wget *|*sh)",
      "Bash(wget *|*bash)"
    ]
  },
  "model": "claude-opus-4-7"
}